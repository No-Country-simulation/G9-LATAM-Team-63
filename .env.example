# ==========================================
# Configuración de Base de Datos
# ==========================================
# Copia este archivo como .env y modifica si lo necesitas
DB_ENERGI_AI=energia_db
DB_USER_MYSQL=root
DB_PASSWORD=rootpassword
DB_PORT=3307

# ==========================================
# Backend (producción)
# ==========================================
# SPRING_PROFILES_ACTIVE=prod
# DB_HOST=<host de la BD en la nube>
# DB_PORT=3306
# DATASCIENCE_URL=https://<tu-api-python>.onrender.com
# APP_JWT_SECRET=<secreto largo aleatorio (min 32 caracteres)>
# APP_CORS_ORIGINS=https://<tu-frontend>.vercel.app

# ==========================================
# Frontend (Vercel)
# ==========================================
# VITE_API_URL=https://<tu-api>.herokuapp.com/api